<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>E-Book - SIPEDI</title>
  <link href="/css/styles.css" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet" />
  <style>
    .line-clamp-2 {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    
    /* Custom search bar effects */
    .search-container {
      position: relative;
    }
    
    .search-container:focus-within {
      transform: scale(1.02);
      transition: transform 0.2s ease-in-out;
    }
    
    .search-input:focus {
      box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.1);
    }
    
    .search-button:hover {
      transform: translateX(2px);
      transition: transform 0.2s ease-in-out;
    }
  </style>
</head>

<body class="bg-[#F8FFF6] font-sans">
  <%- include('../partials/navbarMahasiswa') %>

  <main class="mt-20">
    <div class="flex min-h-screen">
      <aside class="w-64 bg-white shadow-sm p-6">
        <h3 class="text-sm font-semibold text-gray-700 mb-6">Kategori E-Book</h3>
        <ul class="space-y-3 text-sm">
          <li>
            <a href="/mahasiswa/ebook"
               class="block py-2 <%= !selectedKategori ? 'text-green-600 font-semibold' : 'text-gray-600 hover:text-green-600' %>">
              Semua E-Book
            </a>
          </li>
          <% if (kategori && kategori.length > 0) { %>
            <% kategori.forEach(item => { %>
              <li>
                <a href="/mahasiswa/ebook?kategori=<%= item.id_kategori %>"
                class="block py-2 <%= selectedKategori == item.id_kategori ? 'text-green-600 font-semibold' : 'text-gray-600 hover:text-green-600' %>">
                <%= item.nama_kategori %>
              </a>
              </li>
            <% }) %>
          <% } else { %>
            <li><span class="text-gray-400 block py-2">Tidak ada kategori</span></li>
          <% } %>
        </ul>
      </aside>

      <main class="flex-1 p-6">
        <div class="mb-6">
          <div class="bg-gradient-to-r from-green-50 to-emerald-50 rounded-lg p-6 shadow-sm border border-green-100">
            <h1 class="text-2xl font-bold text-gray-800 mb-2 flex items-center">
              <i class="fas fa-book-open text-green-600 mr-3"></i>
              Koleksi E-Book 
            </h1>
            <p class="text-gray-600 text-sm">Temukan koleksi e-book digital yang dapat Anda baca secara online</p>
          </div>
        </div>

        <div class="mb-6">
          <div class="max-w-md ml-auto">
            <form method="GET" action="/mahasiswa/ebook" class="relative search-container">
              <% if (selectedKategori) { %>
                <input type="hidden" name="kategori" value="<%= selectedKategori %>">
              <% } %>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <i class="fas fa-search text-gray-400"></i>
                </div>
                <input 
                  type="text" 
                  name="search"
                  placeholder="Cari e-book judul atau pengarang..."
                  value="<%= searchQuery %>" 
                  class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent bg-white shadow-sm hover:shadow-md transition-all duration-200 text-sm search-input"
                >
                <div class="absolute inset-y-0 right-0 pr-3 flex items-center">
                  <button type="submit" class="text-gray-400 hover:text-green-600 transition-colors duration-200 search-button">
                    <i class="fas fa-arrow-right"></i>
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6 text-sm">
          <% if (ebook && ebook.length > 0) { %>
            <% ebook.forEach(b => { %>
              <a href="/mahasiswa/detailbuku/<%= b.nomor_isbn %>" class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transform hover:scale-105 transition-all duration-300 ease-in-out block">
                <div class="p-4">
                  <div class="w-full h-48 bg-gray-100 overflow-hidden shadow-md mb-4 relative">
                    <img 
                      src="/uploads/covers/<%= b.upload_sampul %>" 
                      alt="<%= b.judul_buku %>" 
                      class="w-full h-full object-cover">
                    <div class="absolute top-2 right-2 bg-green-500 text-white text-xs px-2 py-1 rounded-full font-semibold">
                      <i class="fas fa-book-open mr-1"></i>E-Book
                    </div>
                  </div>
                  
                  <div>
                    <h3 class="font-semibold text-gray-800 mb-1 line-clamp-2 hover:text-green-600 transition-colors duration-200"><%= b.judul_buku %></h3>
                    <p class="text-sm text-gray-500 hover:text-gray-700 transition-colors duration-200"><%= b.pengarang %></p>
                  </div>
                </div>
              </a>
            <% }) %>
          <% } else { %>
            <div class="col-span-full text-center py-12">
              <div class="text-gray-400 mb-4">
                <i class="fas fa-book-open text-6xl"></i>
              </div>
              <p class="text-gray-500 text-lg font-medium">Tidak ada e-book ditemukan</p>
              <p class="text-gray-400 text-sm mt-2">Coba ubah filter pencarian atau kategori</p>
            </div>
          <% } %>
        </div>

        <% if (typeof pagination !== 'undefined' && pagination.totalPages > 1) { %>
          <div class="mt-8 flex justify-center text-sm">
            <nav class="flex items-center space-x-2">
              <% if (pagination.hasPrevPage) { %>
                <a href="/mahasiswa/ebook?page=<%= pagination.prevPage %><%= selectedKategori ? '&kategori=' + selectedKategori : '' %><%= searchQuery ? '&search=' + searchQuery : '' %>" 
                   class="px-3 py-2 text-gray-500 bg-white border border-gray-300 rounded-md hover:bg-gray-50 transition-colors duration-200">
                  <i class="fas fa-chevron-left mr-1"></i>Previous
                </a>
              <% } else { %>
                <button disabled class="px-3 py-2 text-gray-300 bg-gray-100 border border-gray-200 rounded-md cursor-not-allowed">
                  <i class="fas fa-chevron-left mr-1"></i>Previous
                </button>
              <% } %>

              <% 
                let startPage = Math.max(1, pagination.currentPage - 2);
                let endPage = Math.min(pagination.totalPages, pagination.currentPage + 2);
              
                if (endPage - startPage < 4 && pagination.totalPages > 4) {
                  if (startPage === 1) {
                    endPage = Math.min(pagination.totalPages, startPage + 4);
                  }
                }
                
                if (endPage - startPage < 4 && pagination.totalPages > 4) {
                  if (endPage === pagination.totalPages) {
                    startPage = Math.max(1, endPage - 4);
                  }
                }
              %>

              <% if (startPage > 1) { %>
                <a href="/mahasiswa/ebook?page=1<%= selectedKategori ? '&kategori=' + selectedKategori : '' %><%= searchQuery ? '&search=' + searchQuery : '' %>" 
                   class="px-3 py-2 text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 transition-colors duration-200">
                  1
                </a>
                <% if (startPage > 2) { %>
                  <span class="px-2 text-gray-400">...</span>
                <% } %>
              <% } %>

              <% for (let i = startPage; i <= endPage; i++) { %>
                <% if (i === pagination.currentPage) { %>
                  <button class="px-3 py-2 bg-green-600 text-white rounded-md font-medium">
                    <%= i %>
                  </button>
                <% } else { %>
                  <a href="/mahasiswa/ebook?page=<%= i %><%= selectedKategori ? '&kategori=' + selectedKategori : '' %><%= searchQuery ? '&search=' + searchQuery : '' %>" 
                     class="px-3 py-2 text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 transition-colors duration-200">
                    <%= i %>
                  </a>
                <% } %>
              <% } %>

              <% if (endPage < pagination.totalPages) { %>
                <% if (endPage < pagination.totalPages - 1) { %>
                  <span class="px-2 text-gray-400">...</span>
                <% } %>
                <a href="/mahasiswa/ebook?page=<%= pagination.totalPages %><%= selectedKategori ? '&kategori=' + selectedKategori : '' %><%= searchQuery ? '&search=' + searchQuery : '' %>" 
                   class="px-3 py-2 text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 transition-colors duration-200">
                  <%= pagination.totalPages %>
                </a>
              <% } %>

              <% if (pagination.hasNextPage) { %>
                <a href="/mahasiswa/ebook?page=<%= pagination.nextPage %><%= selectedKategori ? '&kategori=' + selectedKategori : '' %><%= searchQuery ? '&search=' + searchQuery : '' %>" 
                   class="px-3 py-2 text-gray-500 bg-white border border-gray-300 rounded-md hover:bg-gray-50 transition-colors duration-200">
                  Next<i class="fas fa-chevron-right ml-1"></i>
                </a>
              <% } else { %>
                <button disabled class="px-3 py-2 text-gray-300 bg-gray-100 border border-gray-200 rounded-md cursor-not-allowed">
                  Next<i class="fas fa-chevron-right ml-1"></i>
                </button>
              <% } %>

              <div class="ml-4">
                <select id="ebookPageSelector" class="px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-green-500 focus:border-green-500 bg-white text-gray-700">
                  <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                    <option value="<%= i %>" <%= i === pagination.currentPage ? 'selected' : '' %>>Page <%= i %></option>
                  <% } %>
                </select>
              </div>
            </nav>
          </div>

          <div class="mt-4 text-center text-sm text-gray-600">
            Menampilkan <%= ((pagination.currentPage - 1) * pagination.limit) + 1 %> - 
            <%= Math.min(pagination.currentPage * pagination.limit, pagination.totalBooks) %> 
            dari <%= pagination.totalBooks %> e-book
          </div>
        <% } %>
      </main>
    </div>
     <footer
      class="bg-[#2f5d40] text-[#d1d5db] mt-6 px-4 sm:px-6 md:px-10 lg:px-16 py-6"
    >
      <div
        class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0"
      >
        <p class="text-sm select-none">© 2024 SIPEDI. All rights reserved.</p>
        <ul class="flex space-x-6 text-sm font-semibold">
          <li>
            <a class="hover:underline" href="#"> Privacy Policy </a>
          </li>
          <li>
            <a class="hover:underline" href="#"> Terms of Service </a>
          </li>
          <li>
            <a class="hover:underline" href="#"> Contact </a>
          </li>
        </ul>
      </div>
    </footer>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const ebookPageSelector = document.getElementById('ebookPageSelector');
      if (ebookPageSelector) {
        ebookPageSelector.addEventListener('change', function() {
          const selectedPage = this.value;
          const currentKategori = '<%= selectedKategori %>'; 
          const currentSearchQuery = '<%= searchQuery %>'; 
          
          let url = `/mahasiswa/ebook?page=${selectedPage}`;
          
          if (currentKategori && currentKategori !== 'null' && currentKategori !== 'undefined') {
            url += `&kategori=${currentKategori}`;
          }
          if (currentSearchQuery && currentSearchQuery !== 'null' && currentSearchQuery !== 'undefined') {
            url += `&search=${encodeURIComponent(currentSearchQuery)}`;
          }
          
          window.location.href = url;
        });
      }
    });
  </script>
</body>
</html>