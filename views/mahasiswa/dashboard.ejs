<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Profil Perpustakaan</title>
    <link rel="stylesheet" href="/stylesheets/output.css" />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css"
      rel="stylesheet"
    />
    <style>
      .line-clamp-2 {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      /* Custom CSS for horizontal scrolling with scrollbar hidden */
      .horizontal-scroll-container::-webkit-scrollbar {
        display: none; /* Hide scrollbar for Webkit browsers */
      }
      .horizontal-scroll-container {
        -ms-overflow-style: none;  /* IE and Edge */
        scrollbar-width: none;  /* Firefox */
      }
      .category-item {
        flex: 0 0 auto; /* Prevent items from growing/shrinking, base on content */
      }
      /* Custom styling for the category buttons to match the image */
      .category-button {
          background-color: oklch(96.2% 0.044 156.743); /* Equivalent to --color-green-100 */
          color: oklch(37.3% 0.034 259.733); /* Equivalent to --color-gray-700 */
          border-radius: 9999px; /* Full rounded corners */
          padding: 1rem 6.2rem; /* py-2 px-6 */
          box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1); /* shadow-sm */
          transition-property: box-shadow, background-color;
          transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
          transition-duration: 150ms; /* default transition duration */
      }
      .category-button:hover {
          box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1); /* shadow-md */
          background-color: oklch(78.92% 0.13678 147.322); /* Equivalent to --color-gray-200 from output.css */
      }
      /* Specific adjustment for arrow positioning based on the image */
      .category-arrows-wrapper {
          position: relative;
          display: flex;
          align-items: center;
      }
      .category-arrows-wrapper button {
          position: absolute;
          top: 50%;
          transform: translateY(-50%);
          background-color: white;
          border: 1px solid oklch(70.7% 0.022 261.325); /* gray-400 equivalent */
      }
      .category-arrows-wrapper button#scrollLeftCategory {
          left: -15px;
      }
      .category-arrows-wrapper button#scrollRightCategory {
          right: -15px;
      }

      /* New styles for book carousel arrows */
      .book-carousel-arrows-wrapper {
          position: relative;
          display: flex;
          align-items: center;
      }
      .book-carousel-arrows-wrapper button {
          position: absolute;
          top: 50%;
          transform: translateY(-50%);
          background-color: white; /* Match category arrows */
          border: 1px solid oklch(70.7% 0.022 261.325); /* Match category arrows */
          padding: 0.5rem; /* Smaller padding for smaller buttons */
          border-radius: 9999px; /* Rounded buttons */
          box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1); /* shadow-sm */
          cursor: pointer;
          z-index: 10;
          transition: background-color 150ms ease-in-out;
      }
      .book-carousel-arrows-wrapper button:hover {
          background-color: oklch(92.8% 0.006 264.531); /* gray-200 on hover */
      }
      .book-carousel-arrows-wrapper button#scrollLeftBook {
          left: -15px; /* Adjust as needed */
      }
      .book-carousel-arrows-wrapper button#scrollRightBook {
          right: -15px; /* Adjust as needed */
      }

      /* Styling for individual book items in the carousel */
      .book-carousel-item {
        flex: 0 0 auto; /* Ensures items don't shrink and maintain their size */
        margin-right: 1rem; /* space-x-4 equivalent */
        width: 120px; /* Default width based on h-[160px] with 3:4 aspect */
      }
     /* Untuk MEMPERBESAR BUKU, ubah nilai di kelas ini (atau buat kelas baru) */
      .book-carousel-item.size-large { /* Anda bisa menambahkan kelas ini ke item buku di EJS */
        width: 200px; /* Lebar yang lebih besar */
      }
      .book-carousel-item.size-large { /* Anda bisa menambahkan kelas ini ke item buku di EJS */
        height: 200px; /* Lebar yang lebih besar */
      }
      .book-carousel-item.size-large img { /* Sesuaikan tinggi gambar agar rasio tetap */
        width: 100px; /* Tinggi yang sesuai (misal, 3:4 dari 150px) */
      }
      .book-carousel-item.size-large img { /* Sesuaikan tinggi gambar agar rasio tetap */
        height: 150px; /* Tinggi yang sesuai (misal, 3:4 dari 150px) */
      }
      
    </style>
  </head>
<body class="bg-gradient-to-br  to-emerald-50 font-sans">
  <%- include('../partials/navbarMahasiswa') %>

  <!-- Hero Section -->
  <main class="mt-20">
    <!-- Enhanced Hero Section -->
    <div class="relative bg-gradient-to-br from-green-800 to-green-900 overflow-hidden">
      <div class="absolute inset-0 bg-cover bg-center opacity-30" style="background-image: url('/images/mahasiswa-dashboard1.png');"></div>
      <div class="relative z-10 py-16 text-center text-white">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 md:px-10 lg:px-16">
          <h1 class="text-4xl md:text-5xl font-bold mb-4 text-white">
            Selamat Datang di SIPEDI
          </h1>
          <p class="text-xl text-green-100 mb-6">
            Sistem Informasi Perpustakaan Digital Universitas Andalas
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <div class="bg-white/20 backdrop-blur-sm rounded-lg px-6 py-3">
              <i class="fas fa-book-open text-2xl text-white mb-2 block"></i>
              <p class="text-white font-medium">Koleksi Digital</p>
            </div>
            <div class="bg-white/20 backdrop-blur-sm rounded-lg px-6 py-3">
              <i class="fas fa-search text-2xl text-white mb-2 block"></i>
              <p class="text-white font-medium">Pencarian dan Peminjaman Cepat</p>
            </div>
            <div class="bg-white/20 backdrop-blur-sm rounded-lg px-6 py-3">
              <i class="fas fa-clock text-2xl text-white mb-2 block"></i>
              <p class="text-white font-medium">24/7 Akses</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="max-w-9xl mx-auto px-4 sm:px-6 md:px-10 lg:px-16">

      <!-- Enhanced Book Recommendation Section -->
      <section class="py-8">
        <div class="bg-gradient-to-br from-green-50 to-emerald-50 py-6 my-8 rounded-xl shadow-sm border border-green-100">
          <h2 class="text-2xl font-bold text-gray-800 mb-2 text-center">
            <i class="fas fa-star text-yellow-500 mr-3"></i>
            Rekomendasi Untuk Anda
          </h2>
          <p class="text-gray-600 text-center">Buku-buku terbaik yang kami rekomendasikan</p>
        </div>
        
        <div class="relative flex items-center">
          <button id="scrollLeftBook" class="absolute left-0 top-1/2 transform -translate-y-1/2 z-10 bg-white border-2 border-gray-200 rounded-full w-10 h-10 flex items-center justify-center shadow-lg hover:bg-gray-50 hover:border-green-500 hover:shadow-xl transition-all duration-300">
              <i class="fas fa-chevron-left text-gray-700"></i>
          </button>

          <div id="booksContainer" class="flex overflow-x-auto py-6 px-12 w-full scrollbar-hide">
            <% if (bukuRekomendasi && bukuRekomendasi.length > 0) { %>
              <% bukuRekomendasi.forEach(buku => { %>
                <div class="flex-none bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transform hover:scale-105 transition-all duration-300 ease-in-out mr-6" style="width: 200px; min-width: 200px;">
                  <a href="/buku/<%= buku.nomor_isbn %>" class="block">
                    <div class="p-4">
                      <!-- Kotak Gambar Sampul -->
                      <div class="w-full h-48 bg-gray-100 overflow-hidden shadow-md mb-4">
                        <img
                          alt="Cover <%= buku.judul_buku %>"
                          class="w-full h-full object-cover"
                          src="/uploads/covers/<%= buku.upload_sampul %>"
                        />
                      </div>
                      
                      <!-- Kotak Judul dan Pengarang -->
                      <div>
                        <h3 class="font-semibold text-gray-800 mb-1 line-clamp-2 hover:text-green-600 transition-colors duration-200 text-sm">
                          <%= buku.judul_buku %>
                        </h3>
                        <p class="text-sm text-gray-500 hover:text-gray-700 transition-colors duration-200">
                          <%= buku.pengarang %>
                        </p>
                      </div>
                    </div>
                  </a>
                </div>
              <% }); %>
            <% } else { %>
              <% for(let i = 0; i < 6; i++) { %>
                <div class="flex-none bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transform hover:scale-105 transition-all duration-300 ease-in-out mr-6" style="width: 200px; min-width: 200px;">
                  <a href="#" class="block">
                    <div class="p-4">
                      <!-- Kotak Gambar Sampul -->
                      <div class="w-full h-48 bg-gray-100 overflow-hidden shadow-md mb-4">
                        <img
                          alt="Placeholder Cover"
                          class="w-full h-full object-cover"
                          src="/images/placeholder-book.png"
                        />
                      </div>
                      
                      <!-- Kotak Judul dan Pengarang -->
                      <div>
                        <h3 class="font-semibold text-gray-800 mb-1 line-clamp-2 hover:text-green-600 transition-colors duration-200 text-sm">
                          Cover Bertarung Melawan Masa Lalu
                        </h3>
                        <p class="text-sm text-gray-500 hover:text-gray-700 transition-colors duration-200">
                          Bertarung Melawan Masa Lalu
                        </p>
                      </div>
                    </div>
                  </a>
                </div>
              <% } %>
            <% } %>
          </div>

          <button id="scrollRightBook" class="absolute right-0 top-1/2 transform -translate-y-1/2 z-10 bg-white border-2 border-gray-200 rounded-full w-10 h-10 flex items-center justify-center shadow-lg hover:bg-gray-50 hover:border-green-500 hover:shadow-xl transition-all duration-300">
              <i class="fas fa-chevron-right text-gray-700"></i>
          </button>
        </div>
      </section>

      <!-- Enhanced Category Section -->
      <section class="py-8">
        <div class="bg-gradient-to-br from-green-50 to-emerald-50 py-6 my-8 rounded-xl shadow-sm border border-green-100">
          <h2 class="text-2xl font-bold text-gray-800 mb-2 text-center">
            <i class="fas fa-tags text-blue-500 mr-3"></i>
            Kategori Buku
          </h2>
          <p class="text-gray-600 text-center">Jelajahi koleksi berdasarkan kategori</p>
        </div>
        
        <div class="relative flex items-center">
            <button id="scrollLeftCategory" class="absolute left-0 top-1/2 transform -translate-y-1/2 z-10 bg-white border-2 border-gray-200 rounded-full w-10 h-10 flex items-center justify-center shadow-lg hover:bg-gray-50 hover:border-green-500 hover:shadow-xl transition-all duration-300">
                <i class="fas fa-chevron-left text-gray-700"></i>
            </button>

            <div id="categoriesContainer" class="flex overflow-x-auto space-x-4 py-4 px-12 w-full scrollbar-hide">
                <% if (categories && categories.length > 0) { %>
                    <% categories.forEach(kategori => { %>
                        <div class="flex-none">
                            <a href="/mahasiswa/koleksibuku?kategori=<%= kategori.id_kategori %>" class="block bg-gradient-to-br from-green-700 to-green-900 text-white font-medium rounded-full px-8 py-3 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 hover:from-green-500 hover:to-green-700 whitespace-nowrap">
                                <i class="fas fa-folder mr-2"></i>
                                <%= kategori.nama_kategori %>
                            </a>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="col-span-full text-center text-gray-500 w-full">Tidak ada kategori untuk ditampilkan.</div>
                <% } %>
            </div>

            <button id="scrollRightCategory" class="absolute right-0 top-1/2 transform -translate-y-1/2 z-10 bg-white border-2 border-gray-200 rounded-full w-10 h-10 flex items-center justify-center shadow-lg hover:bg-gray-50 hover:border-green-500 hover:shadow-xl transition-all duration-300">
                <i class="fas fa-chevron-right text-gray-700"></i>
            </button>
        </div>
      </section>

    </div>

    <!-- Enhanced Logo Section -->
    <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-2xl p-8 mx-4 sm:mx-6 md:mx-10 lg:mx-16 my-20 shadow-xl border border-green-100">
      <div class="flex flex-col lg:flex-row items-center justify-center gap-8">
        <div class="text-center lg:text-left">
          <img
            alt="Logo of Perpustakaan Universitas Andalas with green and yellow emblem"
            height="150"
            src="/images/logo-unand.png"
            width="300"
            class="mb-6 lg:mb-0"
          />
        </div>
        <div class="max-w-2xl">
          <h3 class="text-2xl font-bold text-gray-800 mb-4">
            <i class="fas fa-university text-green-600 mr-3"></i>
            Perpustakaan Universitas Andalas
          </h3>
          <p class="text-gray-700 leading-relaxed mb-6">
            <span class="font-semibold italic text-green-700">
              Perpustakaan Universitas Andalas
            </span>
            hadir sebagai pusat pengetahuan yang mendukung proses pendidikan,
            penelitian, dan pengabdian masyarakat. Dengan koleksi digital yang terus
            berkembang dan layanan informasi
            <span class="font-semibold text-green-700"> berbasis teknologi </span>
            , kami berkomitmen memberikan akses informasi yang mudah, cepat, dan
            terpercaya bagi seluruh sivitas akademika.
          </p>
          <a
            class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-green-700 to-green-900 text-white font-medium rounded-lg hover:from-green-700 hover:to-emerald-700 transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl"
            href="/mahasiswa/profil"
          >
            <i class="fas fa-user mr-2"></i>
            Lihat Selengkapnya
          </a>
        </div>
      </div>
    </div>

    <!-- Enhanced YouTube Section -->
    <div class="mb-20">
      <iframe
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen=""
        class="rounded"
        frameborder="0"
        height="480"
        src="https://www.youtube.com/embed/_k3wmGUG_0Y?si=xcsygl_U-wlcxj0U"
        title="FASILITAS PERPUSTAKAAN UNIVERSITAS ANDALAS"
        width="100%"
      >
      </iframe>
    </div>

    <!-- Original Footer -->
    <footer
      class="bg-[#2f5d40] text-[#FDFCDD] hover:text-[#FFFB8C] mt-6 px-4 sm:px-6 md:px-10 lg:px-16 py-6"
    >
      <div
        class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0"
      >
        <p class="text-sm select-none">© 2024 SIPEDI. All rights reserved.</p>
        <ul class="flex space-x-6 text-sm font-semibold">
          <li>
            <a class="hover:underline" href="#"> Privacy Policy </a>
          </li>
          <li>
            <a class="hover:underline" href="#"> Terms of Service </a>
          </li>
          <li>
            <a class="hover:underline" href="#"> Contact </a>
          </li>
        </ul>
      </div>
    </footer>
  </main>

  <style>
    /* Hide scrollbar for webkit browsers */
    .scrollbar-hide::-webkit-scrollbar {
      display: none;
    }
    .scrollbar-hide {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    
    /* Line clamp utility */
    .line-clamp-2 {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      overflow: hidden;
      
    }
  </style>

  <script>
    const categoriesContainer = document.getElementById('categoriesContainer');
    const scrollLeftCategoryButton = document.getElementById('scrollLeftCategory');
    const scrollRightCategoryButton = document.getElementById('scrollRightCategory');

    const booksContainer = document.getElementById('booksContainer');
    const scrollLeftBookButton = document.getElementById('scrollLeftBook');
    const scrollRightBookButton = document.getElementById('scrollRightBook');

    const scrollAmount = 200; // Adjust scroll distance as needed

    // --- Category Scroll Logic ---
    scrollLeftCategoryButton.addEventListener('click', () => {
      categoriesContainer.scrollBy({
        left: -scrollAmount,
        behavior: 'smooth'
      });
    });

    scrollRightCategoryButton.addEventListener('click', () => {
      categoriesContainer.scrollBy({
        left: scrollAmount,
        behavior: 'smooth'
      });
    });

    // --- Book Scroll Logic ---
    scrollLeftBookButton.addEventListener('click', () => {
      booksContainer.scrollBy({
        left: -scrollAmount,
        behavior: 'smooth'
      });
    });

    scrollRightBookButton.addEventListener('click', () => {
      booksContainer.scrollBy({
        left: scrollAmount,
        behavior: 'smooth'
      });
    });

    // --- Always show buttons logic (removed hiding logic) ---
    const updateAllArrowsVisibility = () => {
        // Category arrows
        scrollLeftCategoryButton.style.display = 'block';
        scrollRightCategoryButton.style.display = 'block';

        // Book arrows
        scrollLeftBookButton.style.display = 'block';
        scrollRightBookButton.style.display = 'block';
    };

    updateAllArrowsVisibility(); // Initial call

    // Attach to scroll and resize events for both containers
    categoriesContainer.addEventListener('scroll', updateAllArrowsVisibility);
    window.addEventListener('resize', updateAllArrowsVisibility); // Re-evaluate on resize
    booksContainer.addEventListener('scroll', updateAllArrowsVisibility);
    window.addEventListener('resize', updateAllArrowsVisibility); // Re-evaluate on resize
  </script>
</body>
