<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Laporan Stok Buku Fisik</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20mm; 
            font-size: 10pt;
            color: #333;
        }
        h1 {
            text-align: center;
            font-size: 18pt;
            margin-bottom: 20px;
            color: #276749; 
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }
        th {
            background-color: #276749; 
            color: white;
            font-size: 9pt;
            text-transform: uppercase;
        }
        tr:nth-child(even) {
            background-color: #f2f2f2;
        }
        .text-green-500 { color: #22c55e; } 
        .text-orange-500 { color: #f97316; } 
        .text-red-500 { color: #ef4444; }  

        @media print {
            .no-print {
                display: none;
            }
        }
    </style>
</head>
<body>
    <h1>Laporan Stok Buku Fisik</h1>
    <p style="text-align: right; margin-bottom: 10px;">Tanggal Cetak: <%= new Date().toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' }) %></p>

    <table>
        <thead>
            <tr>
                <th>No</th>
                <th>ISBN</th>
                <th>Judul Buku</th>
                <th>Stok Tersedia</th>
                <th>Stok Dipinjam</th>
                <th>Total Stok</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <% if (stokData.length > 0) { %>
                <% stokData.forEach(stok => { %>
                    <tr>
                        <td><%= stok.no %></td>
                        <td><%= stok.isbn %></td>
                        <td><%= stok.judul_buku %></td>
                        <td><%= stok.stok_tersedia %></td>
                        <td><%= stok.stok_dipinjam %></td>
                        <td><%= stok.total_stok %></td>
                        <td>
                            <span class="<%= stok.status.color %>">
                                <%= stok.status.message %>
                            </span>
                        </td>
                    </tr>
                <% }); %>
            <% } else { %>
                <tr>
                    <td colspan="7" style="text-align: center;">Tidak ada data stok buku fisik.</td>
                </tr>
            <% } %>
        </tbody>
    </table>

    <script>
        window.onload = function() {
            window.print();
        };
    </script>
</body>
</html>