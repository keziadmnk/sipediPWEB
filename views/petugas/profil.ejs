<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <title>Profil Petugas</title>
    <link rel="stylesheet" href="/stylesheets/output.css" />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#f5fef7] text-[#1f4d2a] min-h-screen flex">
    <%- include('../partials/asidePetugas') %>

    <main class="flex-1 ml-56">
      <%- include('../partials/navPetugas') %>

      <section class="py-16 px-40">
        <h2 class="text-[#1f4d2a] font-semibold text-2xl mb-6">
          Profil Petugas
        </h2>
        <section
          class="bg-white rounded-lg shadow-md p-8 max-w-4xl flex flex-col md:flex-row gap-8"
        >
          <div
            class="flex justify-center items-center md:justify-center md:flex-1"
          >
            <div class="flex flex-col items-center">
              <div
                class="rounded-full border-2 border-[#1f4d2a] p-1 w-50 h-50 flex items-center justify-center mb-4"
              >
                <% if (petugas.foto) { %>
                  <img
                    alt="foto petugas"
                    class="rounded-full w-42 h-42 object-cover"
                    height="160"
                    src="<%= petugas.foto %>"
                    width="160"
                  />
                <% } else { %>
                  <div class="flex justify-center items-center w-42 h-42 rounded-full bg-gray-200">
                    <i class="fas fa-user text-6xl text-gray-500"></i>
                  </div>
                <% } %>
              </div>
              
              <!-- Tombol untuk upload foto -->
              <button
                id="ubahFotoBtn"
                class="bg-[#1f4d2a] text-white text-xs font-semibold px-4 py-2 rounded-md hover:bg-[#163a21] transition mb-4"
                type="button"
              >
                Ubah Foto
              </button>

              <!-- Form untuk upload foto (tersembunyi) -->
              <form action="/petugas/profil/upload" method="POST" enctype="multipart/form-data" id="uploadForm" class="hidden">
                <input type="file" name="foto" id="fotoInput" accept="image/*" required>
              </form>
            </div>
          </div>
          <form class="flex-1 flex flex-col gap-4 max-w-md">
            <div>
              <label class="block text-xs font-semibold mb-1" for="namaLengkap">
                Nama Lengkap
              </label>
              <input
                class="w-full rounded border border-[#1f4d2a] bg-[#eaf7f0] px-3 py-2 text-xs text-[#1f4d2a]"
                id="namaLengkap"
                readonly=""
                type="text"
                value="<%= petugas.nama_lengkap %>"
              />
            </div>
            <div>
              <label
                class="block text-xs font-semibold mb-1"
                for="nomorIndukPegawai"
              >
                Nomor Induk Pegawai
              </label>
              <input
                class="w-full rounded border border-[#1f4d2a] bg-[#eaf7f0] px-3 py-2 text-xs text-[#1f4d2a]"
                id="nomorIndukPegawai"
                readonly=""
                type="text"
                value="<%= petugas.id_pengguna %>"
              />
            </div>
            <div>
              <label class="block text-xs font-semibold mb-1" for="email">
                Email
              </label>
              <input
                class="w-full rounded border border-[#1f4d2a] bg-[#eaf7f0] px-3 py-2 text-xs text-[#1f4d2a]"
                id="email"
                readonly=""
                type="text"
                value="<%= petugas.email %>"
              />
            </div>
            <div>
              <label class="block text-xs font-semibold mb-1" for="nomorHP">
                Nomor HP
              </label>
              <input
                class="w-full rounded border border-[#1f4d2a] bg-[#eaf7f0] px-3 py-2 text-xs text-[#1f4d2a]"
                id="nomorHP"
                readonly=""
                type="text"
                value="<%= petugas.nomor_hp %>"  
              />
            </div>
            <div>
              <label class="block text-xs font-semibold mb-1" for="alamat">
                Alamat
              </label>
              <input
                class="w-full rounded border border-[#1f4d2a] bg-[#eaf7f0] px-3 py-2 text-xs text-[#1f4d2a]"
                id="alamat"
                readonly=""
                type="text"
                value="<%= petugas.alamat %>"
              />
            </div>
            
            <div class="flex space-x-3 justify-end mt-6">
              <a href="/petugas/editbiodata">
                <button
                  class="bg-[#276749] text-white text-xs font-semibold px-4 py-2 rounded hover:bg-[#225a3d] transition"
                  type="button"
                >
                  Edit Biodata
                </button>
              </a>
            </div>
          </form>
        </section>
      </section>
    </main>

    <script>
      // Handle upload foto
      document.getElementById('ubahFotoBtn').addEventListener('click', () => {
        document.getElementById('fotoInput').click();
      });

      document.getElementById('fotoInput').addEventListener('change', () => {
        const btn = document.getElementById('ubahFotoBtn');
        const originalText = btn.textContent;
        
        // Show loading state
        btn.disabled = true;
        btn.textContent = 'Uploading...';
        btn.classList.add('opacity-50');
        
        // Submit form
        document.getElementById('uploadForm').submit();
      });
    </script>
  </body>
</html>
