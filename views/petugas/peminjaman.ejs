<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <title>Daftar Peminjaman</title>
    <link rel="stylesheet" href="/stylesheets/output.css" />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css"
      rel="stylesheet"
    />
    <style>
      ::-webkit-scrollbar {
        width: 6px;
      }
      ::-webkit-scrollbar-thumb {
        background-color: #2f855a;
        border-radius: 3px;
      }
      /* Custom Alert Overlay */
      .custom-alert-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s ease, visibility 0.3s ease;
      }
      .custom-alert-overlay.show {
        opacity: 1;
        visibility: visible;
      }
      .custom-alert-box {
        background-color: #fff;
        padding: 2rem;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        width: 90%;
        max-width: 400px;
        text-align: center;
        transform: translateY(-20px);
        transition: transform 0.3s ease;
      }
      .custom-alert-overlay.show .custom-alert-box {
        transform: translateY(0);
      }
    </style>
  </head>
  <body class="bg-[#f5fef7] min-h-screen flex">
    <%- include('../partials/asidePetugas') %>

    <div class="flex-1 flex flex-col ml-56">
      <%- include('../partials/navPetugas') %>

      <main class="flex-1 p-8">
        <h2 class="text-[#276749] font-semibold text-lg mb-6">
          Daftar Peminjaman
        </h2>
        <div
          class="overflow-x-auto rounded-lg shadow-md border border-transparent"
        >
          <table class="min-w-full text-xs text-left text-[#4a5568]">
            <thead
              class="bg-[#276749] text-[10px] font-semibold rounded-t-lg text-white"
            >
              <tr>
                <th class="px-3 py-3 rounded-tl-lg" scope="col">
                  No
                </th>
                <th class="px-3 py-2" scope="col">
                  Id Peminjaman
                </th>
                <th class="px-3 py-2" scope="col">Nama Mahasiswa</th>
                <th class="px-3 py-2" scope="col">Judul Buku</th>
                <th class="px-3 py-2" scope="col">Tanggal Peminjaman</th>
                <th class="px-3 py-2" scope="col">
                  Tanggal Wajib Pengembalian
                </th>
                <th class="px-3 py-2" scope="col">Detail</th>
                <th class="px-3 py-2" scope="col">Status</th>
                <th class="px-3 py-2 rounded-tr-lg" scope="col">Aksi</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-[#e5e7eb]">
              <% datapeminjaman.forEach((peminjaman, index) => { %>
              <tr class="hover:bg-gray-50 transition-colors duration-150 ease-in-out">
                <td class="px-3 py-2 text-center"><%= index + 1 %></td>
                <td class="px-3 py-2"><%= peminjaman.formattedId %></td>
                <td class="px-3 py-2">
                  <%= peminjaman.Pengguna.nama_lengkap %>
                </td>
                <td class="px-3 py-2"><%= peminjaman.Buku.judul_buku %></td>
                <td class="px-3 py-2">
                  <%= peminjaman.tanggal_peminjaman.toLocaleDateString() %>
                </td>
                <td class="px-3 py-2">
                  <%=
                  peminjaman.tanggal_wajib_pengembalian.toLocaleDateString()
                  %>
                </td>
                <td class="px-3 py-2 text-[#276749] text-center">
                  <a
                    href="/petugas/detailpeminjaman/<%= peminjaman.id_peminjaman %>"
                    class="inline-block hover:scale-110 transition-transform duration-200 ease-in-out"
                  >
                    <i class="fas fa-info-circle"></i>
                  </a>
                </td>
                <td class="px-3 py-2 text-[#d69e2e] font-semibold">
                  <%= peminjaman.status_peminjaman %>
                </td>
                <td class="px-3 py-3">
                    <form id="formKembalikan<%= peminjaman.id_peminjaman %>" action="/petugas/peminjaman/kembalikan/<%= peminjaman.id_peminjaman %>" method="POST">
                      <button
                        type="button"
                        onclick="konfirmasiKembalikan('<%= peminjaman.id_peminjaman %>', '<%= peminjaman.Pengguna.nama_lengkap %>', '<%= peminjaman.Buku.judul_buku %>', '<%= peminjaman.tanggal_wajib_pengembalian.toISOString() %>')"
                        class="bg-[#276749] hover:bg-[#225a3d] text-[10px] text-white rounded-full px-3 py-1 transition-all duration-200 ease-in-out transform hover:scale-105 hover:shadow-md cursor-pointer font-semibold"
                      >
                        Kembalikan
                      </button>
                    </form>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </main>
    </div>

    <div id="customAlertOverlay" class="custom-alert-overlay">
      <div class="custom-alert-box">
        <h3 id="alertTitle" class="text-xl font-bold mb-4 text-[#276749]">Konfirmasi Pengembalian</h3>
        <p id="alertMessage" class="text-gray-700 text-sm mb-6 leading-relaxed text-left"></p>
        <div class="flex justify-end space-x-3">
          <button id="cancelAlert" class="bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-2 px-4 rounded-full text-sm">Batal</button>
          <button id="confirmAlert" class="bg-[#276749] hover:bg-[#225a3d] text-white font-bold py-2 px-4 rounded-full text-sm">Konfirmasi</button>
        </div>
      </div>
    </div>

    <script>
      const customAlertOverlay = document.getElementById('customAlertOverlay');
      const alertTitle = document.getElementById('alertTitle');
      const alertMessage = document.getElementById('alertMessage');
      const cancelAlertButton = document.getElementById('cancelAlert');
      const confirmAlertButton = document.getElementById('confirmAlert');
      let currentFormId = '';

      function showCustomAlert(title, message, formId) {
        alertTitle.textContent = title;
        alertMessage.innerHTML = message; // Use innerHTML to render line breaks and bold
        currentFormId = formId;
        customAlertOverlay.classList.add('show');
      }

      function hideCustomAlert() {
        customAlertOverlay.classList.remove('show');
        currentFormId = '';
      }

      cancelAlertButton.addEventListener('click', hideCustomAlert);

      confirmAlertButton.addEventListener('click', () => {
        if (currentFormId) {
          document.getElementById(currentFormId).submit();
        }
        hideCustomAlert();
      });

      function konfirmasiKembalikan(idPeminjaman, namaMahasiswa, judulBuku, tanggalWajib) {
        const tanggalWajibPengembalian = new Date(tanggalWajib);
        const tanggalSekarang = new Date();
        
        // Normalize both dates to midnight for accurate comparison
        const wajibMidnight = new Date(tanggalWajibPengembalian);
        wajibMidnight.setHours(0, 0, 0, 0);
        
        const sekarangMidnight = new Date(tanggalSekarang);
        sekarangMidnight.setHours(0, 0, 0, 0);

        const isTerlambat = sekarangMidnight > wajibMidnight;
        
        let pesan = `Yakin ingin mengembalikan buku ini?<br><br>`;
        pesan += `<strong>Mahasiswa:</strong> ${namaMahasiswa}<br>`;
        pesan += `<strong>Judul Buku:</strong> ${judulBuku}<br>`;
        pesan += `<strong>Tanggal Wajib Pengembalian:</strong> ${tanggalWajibPengembalian.toLocaleDateString('id-ID')}<br><br>`;
        
        if (isTerlambat) {
          const selisihMs = sekarangMidnight.getTime() - wajibMidnight.getTime();
          const selisihHari = Math.ceil(selisihMs / (1000 * 60 * 60 * 24));
          const denda = selisihHari * 5000;
          pesan += `<p class="text-red-600 font-bold">⚠️ PERHATIAN: Buku terlambat ${selisihHari} hari!</p>`;
          pesan += `<p class="text-red-600 font-bold">Denda yang akan dikenakan: Rp${denda.toLocaleString('id-ID')}</p><br>`;
          pesan += `<span class="text-sm italic">Silakan cek detail denda di halaman detail peminjaman.</span>`;
        } else {
          pesan += `Buku akan dikembalikan tepat waktu.`;
        }
        
        showCustomAlert('Konfirmasi Pengembalian', pesan, `formKembalikan${idPeminjaman}`);
      }
    </script>
  </body>
</html>