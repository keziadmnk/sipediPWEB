<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <title>Daftar Peminjaman</title>
    <!-- <script src="https://cdn.tailwindcss.com"></script> -->

    <link rel="stylesheet" href="/stylesheets/output.css" />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css"
      rel="stylesheet"
    />
    <style>
      ::-webkit-scrollbar {
        width: 6px;
      }
      ::-webkit-scrollbar-thumb {
        background-color: #2f855a;
        border-radius: 3px;
      }
    </style>
  </head>
  <body class="bg-[#f5fef7] min-h-screen flex">
    <%- include('../partials/asidePetugas') %>

    <div class="flex-1 flex flex-col ml-56">
      <%- include('../partials/navpetugas') %>

      <main class="flex-1 p-8">
        <h2 class="text-[#276749] font-semibold text-lg mb-6">
          Daftar Peminjaman
        </h2>
        <div
          class="overflow-x-auto rounded-lg shadow-md border border-transparent"
        >
          <table class="min-w-full text-xs text-left text-[#4a5568]">
            <thead
              class="bg-[#276749] text-[10px] font-semibold rounded-t-lg text-white"
            >
              <tr>
                <th class="px-3 py-3 rounded-tl-lg" scope="col">
                  No
                </th>
                <th class="px-3 py-2" scope="col">
                  Id Peminjaman
                </th>
                <th class="px-3 py-2" scope="col">Nama Mahasiswa</th>
                <th class="px-3 py-2" scope="col">Judul Buku</th>
                <th class="px-3 py-2" scope="col">Tanggal Peminjaman</th>
                <th class="px-3 py-2" scope="col">
                  Tanggal Wajib Pengembalian
                </th>
                <th class="px-3 py-2" scope="col">Detail</th>
                <th class="px-3 py-2" scope="col">Status</th>
                <th class="px-3 py-2 rounded-tr-lg" scope="col">Aksi</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-[#e5e7eb]">
              <% datapeminjaman.forEach((peminjaman, index) => { %>
              <tr class="hover:bg-gray-50 transition-colors duration-150 ease-in-out">
                <td class="px-3 py-2 text-center"><%= index + 1 %></td>
                <td class="px-3 py-2"><%= peminjaman.formattedId %></td>
                <td class="px-3 py-2">
                  <%= peminjaman.Pengguna.nama_lengkap %>
                </td>
                <td class="px-3 py-2"><%= peminjaman.Buku.judul_buku %></td>
                <td class="px-3 py-2">
                  <%= peminjaman.tanggal_peminjaman.toLocaleDateString() %>
                </td>
                <td class="px-3 py-2">
                  <%=
                  peminjaman.tanggal_wajib_pengembalian.toLocaleDateString()
                  %>
                </td>
                <td class="px-3 py-2 text-[#276749] text-center">
                  <a
                    href="/petugas/detailpeminjaman/<%= peminjaman.id_peminjaman %>"
                    class="inline-block hover:scale-110 transition-transform duration-200 ease-in-out"
                  >
                    <i class="fas fa-info-circle"></i>
                  </a>
                </td>
                <td class="px-3 py-2 text-[#d69e2e] font-semibold">
                  <%= peminjaman.status_peminjaman %>
                </td>
                <td class="px-3 py-3">
                    <form id="formKembalikan<%= peminjaman.id_peminjaman %>" action="/petugas/peminjaman/kembalikan/<%= peminjaman.id_peminjaman %>" method="POST">
                      <button
                        type="button"
                        onclick="konfirmasiKembalikan('<%= peminjaman.id_peminjaman %>', '<%= peminjaman.Pengguna.nama_lengkap %>', '<%= peminjaman.Buku.judul_buku %>', '<%= peminjaman.tanggal_wajib_pengembalian.toISOString() %>')"
                        class="bg-[#276749] hover:bg-[#225a3d] text-[10px] text-white rounded-full px-3 py-1 transition-all duration-200 ease-in-out transform hover:scale-105 hover:shadow-md cursor-pointer font-semibold"
                      >
                        Kembalikan
                      </button>
                    </form>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </main>
    </div>

    <script>
      function konfirmasiKembalikan(idPeminjaman, namaMahasiswa, judulBuku, tanggalWajib) {
        const tanggalWajibPengembalian = new Date(tanggalWajib);
        const tanggalSekarang = new Date();
        const isTerlambat = tanggalSekarang > tanggalWajibPengembalian;
        
        let pesan = `Apakah Anda yakin akan mengembalikan buku?\n\n`;
        pesan += `Mahasiswa: ${namaMahasiswa}\n`;
        pesan += `Judul Buku: ${judulBuku}\n`;
        pesan += `Tanggal Wajib Pengembalian: ${tanggalWajibPengembalian.toLocaleDateString('id-ID')}\n\n`;
        
        if (isTerlambat) {
          const selisihHari = Math.ceil((tanggalSekarang - tanggalWajibPengembalian) / (1000 * 60 * 60 * 24));
          const denda = selisihHari * 5000;
          pesan += `⚠️ PERHATIAN: Buku terlambat ${selisihHari} hari!\n`;
          pesan += `Denda yang akan dikenakan: Rp${denda.toLocaleString('id-ID')}\n\n`;
          pesan += `Silakan cek detail denda di halaman detail peminjaman.`;
        } else {
          pesan += `Buku akan dikembalikan tepat waktu.`;
        }
        
        if (confirm(pesan)) {
          document.getElementById(`formKembalikan${idPeminjaman}`).submit();
        }
      }
    </script>
  </body>
</html>
