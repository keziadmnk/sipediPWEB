<!DOCTYPE html>
<html lang="eng">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SIPEDI</title>
    <link rel="stylesheet" href="/stylesheets/output.css" />
    <link
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
      rel="stylesheet"
    />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css"
      rel="stylesheet"
    />

    <style>
      ::-webkit-scrollbar {
        width: 6px;
      }
      ::-webkit-scrollbar-thumb {
        background-color: #2f855a;
        border-radius: 3px;
      }
    </style>
  </head>
  <body class="bg-[#f5fef7] min-h-screen flex">
    <%- include('../partials/asidePetugas') %>

    <main class="flex-1 flex flex-col ml-56">
      <%- include('../partials/navPetugas') %>

      <section class="flex-1 p-4">
        <div
          class="bg-white rounded-lg shadow-md p-6 max-w-5xl mx-auto"
          style="min-width: 320px"
        >
          <div
            class="flex items-center mb-4 text-[#2f6f4e] font-semibold text-lg"
          >
            <a href="/petugas/peminjaman" aria-label="Back">
              <button
                aria-label="Back"
                class="mr-3 text-[#2f6f4e] hover:text-[#1f4b2f]"
              >
                <i class="fas fa-arrow-left"> </i>
              </button>
            </a>
            Detail Peminjaman
          </div>
          <hr class="border-[#2f6f4e] mb-6" />

          <% 
          const tanggalWajib = new Date(datapeminjaman.tanggal_wajib_pengembalian);
          const tanggalSekarang = new Date();
          
          // Normalize both dates to midnight for accurate comparison
          const wajibMidnight = new Date(tanggalWajib);
          wajibMidnight.setHours(0, 0, 0, 0);
          
          const sekarangMidnight = new Date(tanggalSekarang);
          sekarangMidnight.setHours(0, 0, 0, 0);
          
          const isTerlambat = sekarangMidnight > wajibMidnight;
          const selisihHari = isTerlambat ? Math.ceil((sekarangMidnight - wajibMidnight) / (1000 * 60 * 60 * 24)) : 0;
          const dendaPerHari = 5000;
          const dendaTotal = selisihHari * dendaPerHari;
          %>

          <% if (isTerlambat && datapeminjaman.status_peminjaman === 'Dipinjam') { %>
          <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
            <div class="flex items-center">
              <i class="fas fa-exclamation-triangle mr-2"></i>
              <strong>PERHATIAN: Buku Terlambat!</strong>
            </div>
            <div class="mt-2 text-sm">
              <p>Buku ini terlambat <strong><%= selisihHari %> hari</strong> dari tanggal wajib pengembalian.</p>
              <p>Denda yang akan dikenakan: <strong>Rp<%= dendaTotal.toLocaleString('id-ID') %></strong> (Rp<%= dendaPerHari.toLocaleString('id-ID') %> per hari)</p>
            </div>
          </div>
          <% } %>

          <form
            class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-6 text-[#2f6f4e] text-sm font-semibold"
          >
            <div>
              <h2 class="mb-4 text-[#2f6f4e] font-bold text-sm">
                Informasi Mahasiswa
              </h2>
              <div class="mb-4">
                <label
                  class="block mb-1 font-semibold text-xs text-[#2f6f4e]"
                  for="nama-lengkap"
                >
                  Nama Lengkap
                </label>
                <input
                  class="w-full rounded border border-[#2f6f4e] bg-[#f0f6f1] px-2 py-1 text-xs font-normal text-[#2f6f4e]"
                  id="nama-lengkap"
                  readonly=""
                  type="text"
                  value="<%= datapeminjaman.Pengguna.nama_lengkap %>"
                />
              </div>
              <div class="mb-4">
                <label
                  class="block mb-1 font-semibold text-xs text-[#2f6f4e]"
                  for="nomor-induk"
                >
                  Nomor Induk Mahasiswa
                </label>
                <input
                  class="w-full rounded border border-[#2f6f4e] bg-[#f0f6f1] px-2 py-1 text-xs font-normal text-[#2f6f4e]"
                  id="nomor-induk"
                  readonly=""
                  type="text"
                  value="<%= datapeminjaman.Pengguna.id_pengguna %>"
                />
              </div>
              <div>
                <label
                  class="block mb-1 font-semibold text-xs text-[#2f6f4e]"
                  for="email"
                >
                  Email
                </label>
                <input
                  class="w-full rounded border border-[#2f6f4e] bg-[#f0f6f1] px-2 py-1 text-xs font-normal text-[#2f6f4e]"
                  id="email"
                  readonly=""
                  type="email"
                  value="<%= datapeminjaman.Pengguna.email %>"
                />
              </div>
            </div>

            <div>
              <h2 class="mb-4 text-[#2f6f4e] font-bold text-sm">
                Informasi Buku
              </h2>
              <div class="mb-4">
                <label
                  class="block mb-1 font-semibold text-xs text-[#2f6f4e]"
                  for="judul-buku"
                >
                  Judul Buku
                </label>
                <input
                  class="w-full rounded border border-[#2f6f4e] bg-[#f0f6f1] px-2 py-1 text-xs font-normal text-[#2f6f4e]"
                  id="judul-buku"
                  readonly=""
                  type="text"
                  value="<%= datapeminjaman.Buku.judul_buku %>"
                />
              </div>
              <div class="mb-4">
                <label
                  class="block mb-1 font-semibold text-xs text-[#2f6f4e]"
                  for="pengarang"
                >
                  Pengarang
                </label>
                <input
                  class="w-full rounded border border-[#2f6f4e] bg-[#f0f6f1] px-2 py-1 text-xs font-normal text-[#2f6f4e]"
                  id="pengarang"
                  readonly=""
                  type="text"
                  value="<%= datapeminjaman.Buku.pengarang %>"
                />
              </div>
              <div>
                <label
                  class="block mb-1 font-semibold text-xs text-[#2f6f4e]"
                  for="nomor-isbn"
                >
                  Nomor ISBN
                </label>
                <input
                  class="w-full rounded border border-[#2f6f4e] bg-[#f0f6f1] px-2 py-1 text-xs font-normal text-[#2f6f4e]"
                  id="nomor-isbn"
                  readonly=""
                  type="text"
                  value="<%= datapeminjaman.Buku.nomor_isbn %>"
                />
              </div>
            </div>

            <!-- Informasi Peminjaman -->
            <div>
              <h2
                class="mb-4 text-[#2f6f4e] font-bold text-sm col-span-full md:col-span-1"
              >
                Informasi Peminjaman
              </h2>
              <div class="mb-4">
                <label
                  class="block mb-1 font-semibold text-xs text-[#2f6f4e]"
                  for="id-peminjaman"
                >
                  ID Peminjaman
                </label>
                <input
                  class="w-48 rounded border border-[#2f6f4e] bg-[#f0f6f1] px-2 py-1 text-xs font-normal text-[#2f6f4e]"
                  id="id-peminjaman"
                  readonly=""
                  type="text"
                  value="<%= datapeminjaman.formattedId %>"
                />
              </div>
              <div class="mb-4">
                <label
                  class="block mb-1 font-semibold text-xs text-[#2f6f4e]"
                  for="tanggal-pinjam"
                >
                  Tanggal Pinjam
                </label>
                <input
                  class="w-48 rounded border border-[#2f6f4e] bg-[#f0f6f1] px-2 py-1 text-xs font-normal text-[#2f6f4e]"
                  id="tanggal-pinjam"
                  readonly=""
                  type="text"
                  value="<%= datapeminjaman.tanggal_peminjaman.toLocaleDateString() %>"
                />
              </div>
              <div class="mb-4">
                <label
                  class="block mb-1 font-semibold text-xs text-[#2f6f4e]"
                  for="tanggal-maksimal"
                >
                  Tanggal Maksimal Pengembalian
                </label>
                <input
                  class="w-48 rounded border border-[#2f6f4e] bg-[#f0f6f1] px-2 py-1 text-xs font-normal text-[#2f6f4e]"
                  id="tanggal-maksimal"
                  readonly=""
                  type="text"
                  value="<%= datapeminjaman.tanggal_wajib_pengembalian.toLocaleDateString() %>"
                />
              </div>
              <div class="mb-4">
                <label
                  class="block mb-1 font-semibold text-xs text-[#2f6f4e]"
                  for="lokasi-buku"
                >
                  Lokasi Buku
                </label>
                <input
                  class="w-48 rounded border border-[#2f6f4e] bg-[#f0f6f1] px-2 py-1 text-xs font-normal text-[#2f6f4e]"
                  id="lokasi-buku"
                  readonly=""
                  type="text"
                  value="<%= datapeminjaman.Buku.lokasi_penyimpanan %>"
                />
              </div>
              <div class="mb-4">
                <label
                  class="block mb-1 font-semibold text-xs text-[#2f6f4e]"
                  for="status-peminjaman"
                >
                  Status Peminjaman
                </label>
                <input
                  class="w-48 rounded border border-[#2f6f4e] bg-[#f0f6f1] px-2 py-1 text-xs font-normal text-[#2f6f4e]"
                  id="status-peminjaman"
                  readonly=""
                  type="text"
                  value="<%= datapeminjaman.status_peminjaman %>"
                />
              </div>
              <% if (datapeminjaman.tanggal_pengembalian) { %>
              <div class="mb-4">
                <label
                  class="block mb-1 font-semibold text-xs text-[#2f6f4e]"
                  for="tanggal-pengembalian"
                >
                  Tanggal Pengembalian
                </label>
                <input
                  class="w-48 rounded border border-[#2f6f4e] bg-[#f0f6f1] px-2 py-1 text-xs font-normal text-[#2f6f4e]"
                  id="tanggal-pengembalian"
                  readonly=""
                  type="text"
                  value="<%= datapeminjaman.tanggal_pengembalian.toLocaleDateString() %>"
                />
              </div>
              <% } %>
              <div>
                <label
                  class="block mb-1 font-semibold text-xs text-[#2f6f4e]"
                  for="total-denda"
                >
                  Total Denda
                </label>
                <input
                  class="w-48 rounded border border-[#2f6f4e] bg-[#f0f6f1] px-2 py-1 text-xs font-normal text-[#2f6f4e]"
                  id="total-denda"
                  readonly=""
                  type="text"
                  value="<%= isTerlambat ? 'Rp' + dendaTotal.toLocaleString('id-ID') : 'Rp0' %>"
                />
              </div>
            </div>
          </form>

          <% if (datapeminjaman.status_peminjaman === 'Dipinjam') { %>
          <div class="mt-6 pt-6 border-t border-[#2f6f4e]">
            <div class="flex justify-between items-center">
              <div>
                <h3 class="text-[#2f6f4e] font-semibold text-sm mb-2">Aksi Peminjaman</h3>
                <% if (isTerlambat) { %>
                <p class="text-red-600 text-xs mb-2">
                  <i class="fas fa-exclamation-circle mr-1"></i>
                  Buku terlambat <%= selisihHari %> hari. Denda: Rp<%= dendaTotal.toLocaleString('id-ID') %>
                </p>
                <% } %>
              </div>
              <form action="/petugas/peminjaman/kembalikan/<%= datapeminjaman.id_peminjaman %>" method="POST">
                <button
                  type="submit"
                  class="bg-[#276749] hover:bg-[#225a3d] text-white rounded-full px-4 py-2 transition-all duration-200 ease-in-out transform hover:scale-105 hover:shadow-md cursor-pointer font-semibold text-sm"
                >
                  <i class="fas fa-undo mr-2"></i>
                  Kembalikan Buku
                </button>
              </form>
            </div>
          </div>
          <% } %>
        </div>
      </section>
    </main>

    <script>
      function updateDenda() {
        const tanggalWajib = new Date('<%= datapeminjaman.tanggal_wajib_pengembalian.toISOString() %>');
        const tanggalSekarang = new Date();
        
        const wajibMidnight = new Date(tanggalWajib);
        wajibMidnight.setHours(0, 0, 0, 0);
        
        const sekarangMidnight = new Date(tanggalSekarang);
        sekarangMidnight.setHours(0, 0, 0, 0);
        
        const isTerlambat = sekarangMidnight > wajibMidnight;
        const selisihHari = isTerlambat ? Math.ceil((sekarangMidnight - wajibMidnight) / (1000 * 60 * 60 * 24)) : 0;
        const dendaPerHari = 5000;
        const dendaTotal = selisihHari * dendaPerHari;
        
        const totalDendaInput = document.getElementById('total-denda');
        if (totalDendaInput) {
          totalDendaInput.value = isTerlambat ? `Rp${dendaTotal.toLocaleString('id-ID')}` : 'Rp0';
        }
        
        const warningDiv = document.querySelector('.bg-red-100');
        if (warningDiv && isTerlambat) {
          const warningText = warningDiv.querySelector('p:first-of-type');
          const dendaText = warningDiv.querySelector('p:last-of-type');
          if (warningText) {
            warningText.innerHTML = `Buku ini terlambat <strong>${selisihHari} hari</strong> dari tanggal wajib pengembalian.`;
          }
          if (dendaText) {
            dendaText.innerHTML = `Denda yang akan dikenakan: <strong>Rp${dendaTotal.toLocaleString('id-ID')}</strong> (Rp${dendaPerHari.toLocaleString('id-ID')} per hari)`;
          }
        }
        
        const actionSection = document.querySelector('.text-red-600.text-xs');
        if (actionSection && isTerlambat) {
          actionSection.innerHTML = `<i class="fas fa-exclamation-circle mr-1"></i>Buku terlambat ${selisihHari} hari. Denda: Rp${dendaTotal.toLocaleString('id-ID')}`;
        }
      }
      
      setInterval(updateDenda, 60000);
      
      updateDenda();
    </script>
  </body>
</html>
