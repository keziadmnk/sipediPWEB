<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIPEDI - Edit Buku</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css"
      rel="stylesheet"
    />
  <style>
      /* Custom background color with 33% opacity */
      .bg-custom {
        background-color: #E9F1ED;
      }
  </style>
  
</head>
<body class="bg-green-50 flex ml-56">

  
  <%- include('../partials/asideAdmin') %>

  <div class="flex-1 p-12">

    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-semibold">Edit Buku</h1>
    </div>


    <div class="bg-white shadow-md rounded-lg p-10">
    
      <div class="bg-white shadow-md rounded-lg p-10">
        <form
          action="/admin/editbuku/<%= databuku.nomor_isbn %>"
          method="POST"
          enctype="multipart/form-data"
        >
          <div class="grid grid-cols-2 gap-x-10 gap-y-6">
            <!-- Baris 1 -->
            <div class="col-span-2">
              <label
                for="judul_buku"
                class="block text-sm font-medium text-gray-700"
                >Judul Buku *</label
              >
              <input
                type="text"
                id="judul_buku"
                name="judul_buku"
                value="<%= databuku.judul_buku %>"
                required
                class="w-full bg-[#f0f6f3] border border-transparent rounded-md py-2 px-3 text-sm text-[#2f6f4e] focus:outline-none focus:ring-2 focus:ring-[#2f6f4e]""
              />
            </div>

            <!-- Baris 2 -->
            <div class="col-span-2">
              <label class="block text-sm font-medium text-gray-700"
                >Jenis Buku</label
              >
              <div class="mt-1 flex items-center space-x-6">
                <input
                  type="checkbox"
                  id="buku_fisik"
                  name="jenis_buku[]"
                  value="Buku Fisik"
                  <% if (databuku.jenis && databuku.jenis.some(j => j.nama_jenis === 'Buku Fisik')) { %>checked<% } %>
                  class="mr-2"
                />
                <label for="buku_fisik" class="mr-6">Buku Fisik</label>
                <input
                  type="checkbox"
                  id="e_book"
                  name="jenis_buku[]"
                  value="E-Book"
                  <% if (databuku.jenis && databuku.jenis.some(j => j.nama_jenis === 'E-Book')) { %>checked<% } %>
                  class="mr-2"
                />
                <label for="e_book">E-Book</label>
              </div>
            </div>

            <div>
              <label
                for="kategori"
                class="block text-sm font-medium text-gray-700"
                >Kategori</label
              >
              <select
                id="kategori"
                name="kategori"
                class="w-full bg-[#f0f6f3] border border-transparent rounded-md py-2 px-3 text-sm text-[#2f6f4e] focus:outline-none focus:ring-2 focus:ring-[#2f6f4e]""
              >
                <option value="">Pilih kategori</option>
                <% if (typeof kategori !== 'undefined' && kategori.length > 0) {
                %> <% kategori.forEach(function(item) { %>
                <option value="<%= item.id_kategori %>" <% if (databuku.id_kategori === item.id_kategori) { %>selected<% } %>>
                  <%= item.nama_kategori %>
                </option>
                <% }); %> <% } else { %>
                <option disabled>Tidak ada kategori tersedia</option>
                <% } %>
              </select>
            </div>
            <div>
              <label for="isbn" class="block text-sm font-medium text-gray-700"
                >ISBN *</label
              >
              <input
                type="text"
                id="isbn"
                name="isbn"
                value="<%= databuku.nomor_isbn %>"
                required
                class="w-full bg-[#f0f6f3] border border-transparent rounded-md py-2 px-3 text-sm text-[#2f6f4e] focus:outline-none focus:ring-2 focus:ring-[#2f6f4e]""
              />
            </div>

      
            <div>
              <label
                for="pengarang"
                class="block text-sm font-medium text-gray-700"
                >Pengarang *</label
              >
              <input
                type="text"
                id="pengarang"
                name="pengarang"
                value="<%= databuku.pengarang %>"
                required
                class="mw-full bg-[#f0f6f3] border border-transparent rounded-md py-2 px-3 text-sm text-[#2f6f4e] focus:outline-none focus:ring-2 focus:ring-[#2f6f4e]""
              />
            </div>
            <div>
              <label
                for="tahun_terbit"
                class="block text-sm font-medium text-gray-700"
                >Tahun Terbit *</label
              >
              <select
                name="tahun_terbit"
                id="tahun_terbit"
                required
                class="w-full bg-[#f0f6f3] border border-transparent rounded-md py-2 px-3 text-sm text-[#2f6f4e] focus:outline-none focus:ring-2 focus:ring-[#2f6f4e]""
              >
                <option value="">Pilih tahun</option>
                <% const currentYear = new Date().getFullYear(); for (let year =
                currentYear; year >= 1950; year--) { %>
                <option value="<%= year %>" <% if (databuku.tahun_terbit === year) { %>selected<% } %>><%= year %></option>
                <% } %>
              </select>
            </div>

            <div>
              <label
                for="penerbit"
                class="block text-sm font-medium text-gray-700"
                >Penerbit *</label
              >
              <input
                type="text"
                id="penerbit"
                name="penerbit"
                value="<%= databuku.penerbit %>"
                required
                class="w-full bg-[#f0f6f3] border border-transparent rounded-md py-2 px-3 text-sm text-[#2f6f4e] focus:outline-none focus:ring-2 focus:ring-[#2f6f4e]""
              />
            </div>
            <div>
              <label
                for="jumlah_halaman"
                class="block text-sm font-medium text-gray-700"
                >Jumlah Halaman *</label
              >
              <input
                type="number"
                id="jumlah_halaman"
                name="jumlah_halaman"
                value="<%= databuku.jumlah_halaman %>"
                min="1"
                required
                class="w-full bg-[#f0f6f3] border border-transparent rounded-md py-2 px-3 text-sm text-[#2f6f4e] focus:outline-none focus:ring-2 focus:ring-[#2f6f4e]""
              />
            </div>

            
            <div>
              <label
                for="lokasi_penyimpanan"
                class="block text-sm font-medium text-gray-700"
                >Lokasi Penyimpanan</label
              >
              <select
                id="lokasi_penyimpanan"
                name="lokasi_penyimpanan"
                class="w-full bg-[#f0f6f3] border border-transparent rounded-md py-2 px-3 text-sm text-[#2f6f4e] focus:outline-none focus:ring-2 focus:ring-[#2f6f4e]""
              >
                <option value="">Pilih lokasi</option>
                <option value="American Corner – Sayap Kanan Lt.2" <% if (databuku.lokasi_penyimpanan === 'American Corner – Sayap Kanan Lt.2') { %>selected<% } %>>
                  American Corner – Sayap Kanan Lt.2
                </option>
                <option value="Minangkabau Corner Lt. 3" <% if (databuku.lokasi_penyimpanan === 'Minangkabau Corner Lt. 3') { %>selected<% } %>>
                  Minangkabau Corner Lt. 3
                </option>
                <option value="Ruang Lokal Konten – Skripsi" <% if (databuku.lokasi_penyimpanan === 'Ruang Lokal Konten – Skripsi') { %>selected<% } %>>
                  Ruang Lokal Konten – Skripsi
                </option>
                <option value="Ruang Referensi – Sayap Kiri Lantai 2" <% if (databuku.lokasi_penyimpanan === 'Ruang Referensi – Sayap Kiri Lantai 2') { %>selected<% } %>>
                  Ruang Referensi – Sayap Kiri Lantai 2
                </option>
                <option value="Ruang Sirkulasi 2 – Sayap Kanan Lantai 1" <% if (databuku.lokasi_penyimpanan === 'Ruang Sirkulasi 2 – Sayap Kanan Lantai 1') { %>selected<% } %>>
                  Ruang Sirkulasi 2 – Sayap Kanan Lantai 1
                </option>
                <option value="Ruang Sirkulasi Utama – Sayap Kiri Lantai 1" <% if (databuku.lokasi_penyimpanan === 'Ruang Sirkulasi Utama – Sayap Kiri Lantai 1') { %>selected<% } %>>
                  Ruang Sirkulasi Utama – Sayap Kiri Lantai 1
                </option>
              </select>
            </div>
            <div>
              <label
                for="jumlah_stok"
                class="block text-sm font-medium text-gray-700"
                >Jumlah Stok </label
              >
              <input
                type="number"
                id="jumlah_stok"
                name="jumlah_stok"
                value="<%= databuku.jumlah_stok %>"
                min="1"
                class="w-full bg-[#f0f6f3] border border-transparent rounded-md py-2 px-3 text-sm text-[#2f6f4e] focus:outline-none focus:ring-2 focus:ring-[#2f6f4e]""
              />
            </div>

       
            <div>
              <label
                for="deskripsi"
                class="block text-sm font-medium text-gray-700"
                >Deskripsi</label
              >
              <textarea
                id="deskripsi"
                rows="5"
                name="deskripsi"
                class="w-full bg-[#f0f6f3] border border-transparent rounded-md py-2 px-3 text-sm text-[#2f6f4e] focus:outline-none focus:ring-2 focus:ring-[#2f6f4e]""
              ><%= databuku.deskripsi || '' %></textarea>
            </div>
            <div class="flex flex-col gap-4">
              <div>
                <label
                  for="upload_pdf"
                  class="block text-sm font-medium text-gray-700"
                  >Upload PDF</label
                >
                <input
                  type="file"
                  id="upload_pdf"
                  name="upload_pdf"
                  accept=".pdf"
                  class="w-full bg-[#f0f6f3] border border-transparent rounded-md py-2 px-3 text-sm text-[#2f6f4e] focus:outline-none focus:ring-2 focus:ring-[#2f6f4e]""
                />
                <small class="text-gray-500">Format: PDF, Max: 10MB</small>
                <% if (databuku.upload_pdf) { %>
                <p class="text-sm text-green-600 mt-1">File PDF saat ini: <%= databuku.upload_pdf %></p>
                <% } %>
              </div>
              <div>
                <label
                  for="upload_sampul"
                  class="block text-sm font-medium text-gray-700"
                  >Upload Sampul</label
                >
                <input
                  type="file"
                  id="upload_sampul"
                  name="upload_sampul"
                  accept="image/*"
                  class="w-full bg-[#f0f6f3] border border-transparent rounded-md py-2 px-3 text-sm text-[#2f6f4e] focus:outline-none focus:ring-2 focus:ring-[#2f6f4e]""
                />
                <small class="text-gray-500"
                  >Format: JPG, PNG, GIF, Max: 10MB</small
                >
                <% if (databuku.upload_sampul) { %>
                <p class="text-sm text-green-600 mt-1">File sampul saat ini: <%= databuku.upload_sampul %></p>
                <% } %>
              </div>
            </div>
          </div>

        
          <div class="flex justify-end gap-4 mt-6">
            <a
              href="/admin/databuku"
              class="bg-yellow-400 text-white py-2 px-4 rounded-md hover:bg-yellow-500"
              >Batal</a
            >
            <button
              type="submit"
              class="bg-[#276749] text-white py-2 px-4 rounded-md hover:bg-green-700"
            >
              Simpan
            </button>
          </div>
        </form>
    </div>
  </div>
  
  <script>
    const checkboxFisik = document.getElementById("buku_fisik");
    const checkboxEbook = document.getElementById("e_book");
    const lokasi = document.getElementById("lokasi_penyimpanan");
    const jumlah_stok = document.getElementById("jumlah_stok");
    const uploadPdf = document.getElementById("upload_pdf");

    function updateFormFields() {
      const isFisik = checkboxFisik.checked;
      const isEbook = checkboxEbook.checked;

      // Jika keduanya dipilih, enable semua field
      if (isFisik && isEbook) {
        lokasi.disabled = false;
        jumlah_stok.disabled = false;
        uploadPdf.disabled = false;
        
        lokasi.classList.remove("bg-gray-100");
        jumlah_stok.classList.remove("bg-gray-100");
        uploadPdf.classList.remove("bg-gray-100");
        
        lokasi.setAttribute('required', 'required');
        jumlah_stok.setAttribute('required', 'required');
        uploadPdf.setAttribute('required', 'required');
      } else {
        // Jika hanya satu yang dipilih
        lokasi.disabled = !isFisik;
        jumlah_stok.disabled = !isFisik;
        uploadPdf.disabled = !isEbook;

        lokasi.classList.toggle("bg-gray-100", !isFisik);
        jumlah_stok.classList.toggle("bg-gray-100", !isFisik);
        uploadPdf.classList.toggle("bg-gray-100", !isEbook);

        // Hapus required attribute untuk field yang di-disable
        if (!isFisik) {
          lokasi.removeAttribute('required');
          jumlah_stok.removeAttribute('required');
        } else {
          lokasi.setAttribute('required', 'required');
          jumlah_stok.setAttribute('required', 'required');
        }
        
        if (!isEbook) {
          uploadPdf.removeAttribute('required');
        } else {
          uploadPdf.setAttribute('required', 'required');
        }
      }
    }

    checkboxFisik.addEventListener("change", updateFormFields);
    checkboxEbook.addEventListener("change", updateFormFields);

    // Form validation
    document.querySelector("form").addEventListener("submit", function (e) {
      const isFisik = checkboxFisik.checked;
      const isEbook = checkboxEbook.checked;
      
      // Jika tidak ada yang dipilih, default ke buku fisik
      if (!isFisik && !isEbook) {
        checkboxFisik.checked = true;
      }
      
      const requiredFields = [
        "judul_buku",
        "isbn",
        "pengarang",
        "penerbit",
        "tahun_terbit",
        "jumlah_halaman",
      ];
      
      // Tambahkan field wajib berdasarkan jenis buku
      if (isFisik || (isFisik && isEbook)) {
        requiredFields.push("lokasi_penyimpanan", "jumlah_stok");
      }
      
      // Jika e-book dipilih, PDF wajib
      if (isEbook) {
        requiredFields.push("upload_pdf");
      }
      
      let hasError = false;

      requiredFields.forEach((fieldName) => {
        const field = document.querySelector(`[name="${fieldName}"]`);
        // Skip validation untuk field yang di-disable
        if (field.disabled) {
          return;
        }
        if (!field.value.trim()) {
          field.classList.add("border-red-500");
          hasError = true;
        } else {
          field.classList.remove("border-red-500");
        }
      });

      if (hasError) {
        e.preventDefault();
        alert("Mohon lengkapi semua field yang wajib diisi (*)");
      }
    });

    updateFormFields(); // Jalankan di awal
  </script>
</body>
</html>
