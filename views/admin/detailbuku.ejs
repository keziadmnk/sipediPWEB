<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIPEDI - Detail Buku</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css"
      rel="stylesheet"
    />
  <style>
      .bg-custom {
        background-color: #E9F1ED;
      }
  </style>
  
</head>
<body class="bg-green-50 flex ml-56">

 
  <%- include('../partials/asideAdmin') %>

 
  <div class="flex-1 p-12">
  
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-semibold">Detail Buku</h1>
      <a href="/admin/databuku" class="bg-gray-500 text-white py-2 px-4 rounded-md hover:bg-gray-600">
        <i class="fas fa-arrow-left mr-2"></i>Kembali
      </a>
    </div>

   
    <div class="bg-white shadow-md rounded-lg p-10">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
        <div class="md:col-span-1">
          <div class="bg-gray-100 rounded-lg p-4 flex justify-center items-center h-80">
            <% if (databuku.upload_sampul) { %>
              <img 
                src="/uploads/covers/<%= databuku.upload_sampul %>" 
                alt="Cover <%= databuku.judul_buku %>" 
                class="max-w-full max-h-full object-contain rounded-lg shadow-md"
              />
            <% } else { %>
              <img 
                src="/images/coverbuku.jpeg" 
                alt="Default Cover" 
                class="max-w-full max-h-full object-contain rounded-lg shadow-md"
              />
            <% } %>
          </div>
          
          
          <div class="mt-4 space-y-2">
            <% if (databuku.upload_sampul) { %>
              <div class="text-sm text-gray-600">
                <i class="fas fa-image mr-2"></i>
                Cover: <%= databuku.upload_sampul %>
              </div>
            <% } %>
            <% if (databuku.upload_pdf) { %>
              <div class="text-sm text-gray-600">
                <i class="fas fa-file-pdf mr-2"></i>
                PDF: <%= databuku.upload_pdf %>
              </div>
            <% } %>
          </div>
        </div>

    
        <div class="md:col-span-2">
          <div class="grid grid-cols-2 gap-x-6 gap-y-4">

            <div class="col-span-2">
              <label for="judul_buku" class="block text-xs font-semibold text-[#2f6f4e] mb-1">Judul Buku</label>
              <input type="text" id="judul_buku" name="judul_buku" value="<%= databuku.judul_buku %>" readonly class="w-full bg-[#f0f6f3] border border-transparent rounded-md py-2 px-3 text-sm text-[#2f6f4e] focus:outline-none focus:ring-2 focus:ring-[#2f6f4e]" />
            </div>

            <div class="col-span-2">
              <label for="jenis_buku" class="block text-xs font-semibold text-[#2f6f4e] mb-1">Jenis Buku</label>
              <input type="text" id="jenis_buku" name="jenis_buku" readonly value="<%= databuku.jenis.map(j => j.nama_jenis).join(', ') %>"  class="w-full bg-[#f0f6f3] border border-transparent rounded-md py-2 px-3 text-sm text-[#2f6f4e] focus:outline-none focus:ring-2 focus:ring-[#2f6f4e]" />
            </div>

            <div>
              <label for="kategori" class="block text-xs font-semibold text-[#2f6f4e] mb-1">Kategori</label>
              <input type="text" id="kategori" name="kategori" readonly value="<%= databuku.kategori?.nama_kategori || 'Tidak ada' %>" class="w-full bg-[#f0f6f3] border border-transparent rounded-md py-2 px-3 text-sm text-[#2f6f4e] focus:outline-none focus:ring-2 focus:ring-[#2f6f4e]" />
            </div>
            <div>
              <label for="isbn" class="block text-xs font-semibold text-[#2f6f4e] mb-1">ISBN</label>
              <input type="text" id="isbn" name="isbn" readonly value="<%= databuku.nomor_isbn %>" class="w-full bg-[#f0f6f3] border border-transparent rounded-md py-2 px-3 text-sm text-[#2f6f4e] focus:outline-none focus:ring-2 focus:ring-[#2f6f4e]" />
            </div>

            <div>
              <label for="pengarang" class="block text-xs font-semibold text-[#2f6f4e] mb-1">Pengarang</label>
              <input type="text" id="pengarang" name="pengarang" readonly value="<%= databuku.pengarang %>" class="w-full bg-[#f0f6f3] border border-transparent rounded-md py-2 px-3 text-sm text-[#2f6f4e] focus:outline-none focus:ring-2 focus:ring-[#2f6f4e]" />
            </div>
            <div>
              <label for="tahun_terbit" class="block text-xs font-semibold text-[#2f6f4e] mb-1">Tahun Terbit</label>
              <input type="text" id="tahun_terbit" name="tahun_terbit" readonly value="<%= databuku.tahun_terbit %>" class="w-full bg-[#f0f6f3] border border-transparent rounded-md py-2 px-3 text-sm text-[#2f6f4e] focus:outline-none focus:ring-2 focus:ring-[#2f6f4e]" />
            </div>

 
            <div>
              <label for="penerbit" class="block text-xs font-semibold text-[#2f6f4e] mb-1">Penerbit</label>
              <input type="text" id="penerbit" name="penerbit" readonly value="<%= databuku.penerbit %>" class="w-full bg-[#f0f6f3] border border-transparent rounded-md py-2 px-3 text-sm text-[#2f6f4e] focus:outline-none focus:ring-2 focus:ring-[#2f6f4e]" />
            </div>
            <div>
              <label for="jumlah_halaman" class="block text-xs font-semibold text-[#2f6f4e] mb-1">Jumlah Halaman</label>
              <input type="number" id="jumlah_halaman" name="jumlah_halaman" min="1" readonly value="<%= databuku.jumlah_halaman %>" class="w-full bg-[#f0f6f3] border border-transparent rounded-md py-2 px-3 text-sm text-[#2f6f4e] focus:outline-none focus:ring-2 focus:ring-[#2f6f4e]" />
            </div>

  
            <div>
              <label for="lokasi_penyimpanan" class="block text-xs font-semibold text-[#2f6f4e] mb-1">Lokasi Penyimpanan</label>
              <input type="text" id="lokasi_penyimpanan" name="lokasi_penyimpanan" readonly value="<%= databuku.lokasi_penyimpanan || '' %>" class="w-full bg-[#f0f6f3] border border-transparent rounded-md py-2 px-3 text-sm text-[#2f6f4e] focus:outline-none focus:ring-2 focus:ring-[#2f6f4e]"/>
            </div>
            <div>
              <label for="jumlah_stok" class="block text-xs font-semibold text-[#2f6f4e] mb-1">Jumlah Stok</label>
              <input type="number" id="jumlah_stok" name="jumlah_stok" min="1" readonly value="<%= databuku.jumlah_stok %>" class="w-full bg-[#f0f6f3] border border-transparent rounded-md py-2 px-3 text-sm text-[#2f6f4e] focus:outline-none focus:ring-2 focus:ring-[#2f6f4e]" />
            </div>

            <div class="col-span-2">
              <label for="deskripsi" class="block text-xs font-semibold text-[#2f6f4e] mb-1">Deskripsi</label>
              <textarea id="deskripsi" name="deskripsi" readonly rows="4" class="w-full bg-[#f0f6f3] border border-transparent rounded-md py-2 px-3 text-sm text-[#2f6f4e] focus:outline-none focus:ring-2 focus:ring-[#2f6f4e] resize-none"><%= databuku.deskripsi || 'Tidak ada deskripsi' %></textarea>
            </div>
          </div>

          <div class="flex justify-end gap-4 mt-6">
            <a href="/admin/editbuku/<%= databuku.nomor_isbn %>" class="bg-yellow-400 text-white py-2 px-4 rounded-md hover:bg-yellow-500">
              <i class="fas fa-pencil-alt mr-2"></i>Edit
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
  
</body>
</html>
